# --- Resend (contact form email) ---
# 1. Sign up free at https://resend.com (no credit card required)
# 2. Dashboard -> API Keys -> Create API Key -> paste it below
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address that receives messages from your contact form.
# This MUST be the same email you signed up to Resend with, unless you
# verify a custom domain in Resend (not required to get this working).
CONTACT_TO_EMAIL=your_email@example.com

# Sender shown in the "From" field. onboarding@resend.dev works out of the
# box with zero setup. Only change this if you've verified your own domain
# in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- GitHub (Work Samples / live repo data) ---
# Your GitHub username, e.g. "octocat"
GITHUB_USERNAME=Niramay-Kelkar

# Optional. A classic personal access token with NO scopes checked
# (public read-only access is enough) raises the GitHub API rate limit
# from 60 req/hr to 5,000 req/hr. Safe to leave blank for a personal site.
# Create one at https://github.com/settings/tokens
#GITHUB_TOKEN=

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
# Add your Vercel URL here once deployed, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (backs up contact-form submissions) ---
# Optional. Leave blank and the app runs fine — it just won't save a copy of
# contact-form messages anywhere (they'll still be emailed via Resend above).
#
# 1. Create a free project at https://supabase.com
# 2. Project Settings -> Database -> Connection string -> "URI" tab
# 3. Copy it and swap the "postgresql://" prefix for "postgresql+asyncpg://"
#    (this app uses the async Postgres driver)
# Example:
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=
